RING_INNER = 0.8764


def inside(poly, x, y):
    hit = False
    j = len(poly) - 1
    for i in range(len(poly)):
        xi, yi = poly[i]
        xj, yj = poly[j]
        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi:
            hit = not hit
        j = i
    return hit


def build_points():
    """Sample the logo as a 3D point cloud: front/back faces plus side walls."""
    sx, sy = LOGO_W * 2, LOGO_H * 3          # supersample grid

    def solid(x, y):
        return RING_INNER ** 2 <= x * x + y * y <= 1 or inside(A_OUTLINE, x, y)

    grid = [[solid((i + 0.5) / sx * 2 - 1, 1 - (j + 0.5) / sy * 2)
             for i in range(sx)] for j in range(sy)]
    pts = []  # (x, y, z, nx, nz, bulge_x, bulge_y)
    for j in range(sy):
        for i in range(sx):
            if not grid[j][i]:
                continue
            x, y = (i + 0.5) / sx * 2 - 1, 1 - (j + 0.5) / sy * 2
            pts.append((x, y, DEPTH, 0.0, 1.0, x * 0.6, y * 0.6))
            pts.append((x, y, -DEPTH, 0.0, -1.0, x * 0.6, y * 0.6))
            # edge cells get side walls with an outward horizontal normal
            l = i > 0 and grid[j][i - 1]
            r = i < sx - 1 and grid[j][i + 1]
            if not (l and r):
                nx = -1.0 if not l else 1.0
                for k in range(1, 6):
                    pts.append((x, y, -DEPTH + 2 * DEPTH * k / 6, nx, 0.0, 0.0, 0.0))
    return pts


# --- rendering -------------------------------------------------------------

def color(lum, front):
    # greyscale; the back face is a few steps dimmer than the front
    if front:
        ramp = [242, 245, 248, 251, 253, 255]
    else:
        ramp = [237, 239, 241, 243, 245, 247]
    return ramp[min(len(ramp) - 1, int(lum * len(ramp)))]


def render(pts, angle):
    c, s = math.cos(angle), math.sin(angle)
    zbuf = [[-9.0] * LOGO_W for _ in range(LOGO_H)]
    cell = [[None] * LOGO_W for _ in range(LOGO_H)]
    # light from the viewer, slightly up-left
    lx, ly, lz = -0.4, 0.35, 0.85
    for x, y, z, nx, nz, bx, by in pts:
        u = x * c + z * s
        d = -x * s + z * c
        col = int((u * 0.95 + 1) / 2 * LOGO_W)
        row = int((1 - y * 0.95) / 2 * LOGO_H)
        if 0 <= col < LOGO_W and 0 <= row < LOGO_H and d > zbuf[row][col]:
            rnx = nx * c + nz * s
            rnz = -nx * s + nz * c
            if rnz < -0.05:
                continue
            zbuf[row][col] = d
            # tilt face normals outward (a fake dome) for some shading variety
            fx = rnx + (bx * c if nz > 0 else -bx * c)
            ny = by
            fz = rnz
            norm = math.sqrt(fx * fx + ny * ny + fz * fz) or 1.0
            lum = (fx * lx + ny * ly + fz * lz) / norm
            lum = max(0.0, min(0.999, 0.1 + 0.9 * lum))
            cell[row][col] = (lum, nz > 0 or (nz == 0 and c > 0))
    lines = []
    for row in cell:
        out = []
        last = None
        for v in row:
            if v is None:
                ch, fg = " ", None
            else:
                lum, front = v
                ch = SHADES[1 + int(lum * (len(SHADES) - 2))]
                fg = color(lum, front)
            if fg != last and fg is not None:
                out.append(f"\033[38;5;{fg}m")
                last = fg
            out.append(ch)
        out.append("\033[0m")
        lines.append("".join(out))
    return lines


# --- main ------------------------------------------------------------------

def parse_args(argv):
    loop, secs, ff = True, 0.0, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-l", "--loop"):
            loop = True
        elif a in ("-s", "--seconds") and i + 1 < len(argv):
            loop, secs = False, float(argv[i + 1])
            i += 1
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif a == "--":
            ff = argv[i + 1:]
            break
        else:
            ff.append(a)
        i += 1
    return loop, secs, ff


def main():
    loop, secs, ff_args = parse_args(sys.argv[1:])
    info = subprocess.run(["fastfetch", "--logo", "none", "--pipe", "false", *ff_args],
                          capture_output=True, text=True).stdout
    info = re.sub(r"\033\[\?7[hl]", "", info).rstrip("\n").split("\n")

    pts = build_points()
    height = max(LOGO_H, len(info))
    top = max(0, (height - LOGO_H) // 2)
    pad = " " * LOGO_W

    def frame(angle):
        logo = render(pts, angle)
        return [logo[i - top] if top <= i < top + LOGO_H else pad for i in range(height)]

    tty_out = sys.stdout.isatty()
    term_h = shutil.get_terminal_size((80, 24)).lines
    animate = tty_out and height < term_h

    out = sys.stdout
    if not animate:
        for l, r in zip(frame(0), info + [""] * height):
            out.write(l + " " * GAP + r + "\n")
        return

    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    old = termios.tcgetattr(fd) if fd is not None else None

    def restore(*_):
        if old is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write(f"\033[{height}B\r\033[?7h\033[?25h\033[0m")
        out.flush()

    def on_sigint(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGINT, on_sigint)
    try:
        if fd is not None:
            tty.setcbreak(fd)
        out.write("\033[?25l\033[?7l")  # hide cursor, no wrap
        for l, r in zip(frame(0), info + [""] * height):
            out.write(l + " " * GAP + r + "\033[0m\n")
        out.write(f"\033[{height}A")
        out.flush()

        start = time.time()
        while True:
            t = time.time() - start
            angle = t * RPS * 2 * math.pi
            # finish the current turn so it settles facing front
            if not loop and t * RPS >= max(1, math.ceil(secs * RPS)):
                break
            buf = []
            for l in frame(angle):
                buf.append("\r" + l + "\n")
            buf.append(f"\033[{height}A")
            out.write("".join(buf))
            out.flush()
            if fd is not None and select.select([fd], [], [], 1 / FPS)[0]:
                os.read(fd, 64)
                break
            elif fd is None:
                time.sleep(1 / FPS)
        # settle on the front face
        out.write("".join("\r" + l + "\n" for l in frame(0)) + f"\033[{height}A")
    except KeyboardInterrupt:
        pass
    finally:
        restore()


if __name__ == "__main__":
    main()
